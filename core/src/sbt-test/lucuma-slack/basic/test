> lucumaSlackNotifyGenerate
> checkGenerated
> checkInCi
> lucumaSlackNotifyCheck

# a second run with identical inputs must still write the file: sbt 2 caches every task result
# and would otherwise return the cached one without repeating the side effect
$ delete .github/workflows/ci-failure-slack.yml
> lucumaSlackNotifyGenerate
$ exists .github/workflows/ci-failure-slack.yml

# turning it off removes the file
> set ThisBuild / lucumaSlackNotify := false
> lucumaSlackNotifyGenerate
> lucumaSlackNotifyCheck
$ absent .github/workflows/ci-failure-slack.yml

# editing the file by hand is caught. Last, and with valid YAML: in CI the scripted sbt inherits
# GITHUB_WORKFLOW, so GitHubActionsPlugin parses .github/workflows on every settings reapply.
> set ThisBuild / lucumaSlackNotify := true
> lucumaSlackNotifyGenerate
$ copy-file tampered.yml .github/workflows/ci-failure-slack.yml
-> lucumaSlackNotifyCheck
